{
  "mcpServers": {
    "nrepl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "nrepl-mcp-server"],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated", "--no-sandbox"],
      "env": {}
    }
  }
}
